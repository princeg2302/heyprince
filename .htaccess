DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Don't rewrite if request is already targeting dist/
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # If requested file physically exists on the server (e.g. wp-content/uploads/...), serve directly!
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Map static asset requests directly to dist/
  RewriteRule ^(assets|fonts|images|audio)/(.*)$ dist/$1/$2 [L]
  RewriteRule ^(favicon\.svg|icons\.svg|robots\.txt|sitemap\.xml|heyprince-logo\.svg)$ dist/$1 [L]

  # SPA Fallback: send all other paths directly to dist/index.html
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Googlebot & Crawler Permissions
  Header set X-Robots-Tag "all"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching for production performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
