# ==============================================================================
# HeyPrince Digital Business Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for Payload CMS and Leads persistence.
# Compatible with Neon, Supabase, AWS RDS, DigitalOcean, or local PostgreSQL.
# Example: postgresql://postgres:yourpassword@127.0.0.1:5432/heyprince
# For Neon / Supabase, use your pooled connection string with sslmode=require.
DATABASE_URI="postgresql://postgres:postgres@127.0.0.1:5432/heyprince"

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS CONFIGURATION
# ------------------------------------------------------------------------------
# A strong, cryptographically secure 32+ character secret used to sign JWTs & auth tokens.
PAYLOAD_SECRET="replace-with-a-very-long-random-string-at-least-32-chars-long"

# Default password used by the seed script (npm run seed) for admin: it@heyprince.in
PAYLOAD_ADMIN_PASSWORD="HeyPrinceAdmin2026!"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Required for real-time lead notification emails on contact form submissions.
# Get an API key from https://resend.com
RESEND_API_KEY=""

# The destination inbox that receives new project inquiries from clients
LEAD_NOTIFICATION_EMAIL="it@heyprince.in"

# Verified sender email domain in Resend
# Note: "onboarding@resend.dev" can be used for initial testing to your verified account email
RESEND_FROM_EMAIL="HeyPrince <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. SERVER & CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL="https://heyprince.in"
