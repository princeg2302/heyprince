# ==============================================================================
# HeyPrince Digital Business Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for Payload CMS and Leads persistence.
# Compatible with Neon, Supabase, AWS RDS, DigitalOcean, or local PostgreSQL.
# Example: postgresql://postgres:yourpassword@127.0.0.1:5432/heyprince
# For Neon / Supabase, use your pooled connection string with sslmode=require.
DATABASE_URI="postgresql://postgres:postgres@127.0.0.1:5432/heyprince"

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS CONFIGURATION
# ------------------------------------------------------------------------------
# A strong, cryptographically secure 32+ character secret used to sign JWTs & auth tokens.
PAYLOAD_SECRET="replace-with-a-very-long-random-string-at-least-32-chars-long"

# Default password used by the seed script (npm run seed) for admin: contact@heyprince.in
PAYLOAD_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL NOTIFICATION EMAIL (Hostinger SMTP or Resend)
# ------------------------------------------------------------------------------
# Option A: Hostinger Business Email (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="contact@heyprince.in"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM="HeyPrince Inquiries <contact@heyprince.in>"

# Destination email inbox where inquiries are received
LEAD_NOTIFICATION_EMAIL="contact@heyprince.in"

# Option B: Resend (Alternative transactional provider)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="HeyPrince <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. SERVER & CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL="https://heyprince.in"

# ------------------------------------------------------------------------------
# 5. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 6. GLOBAL LEAD INTELLIGENCE & AI OUTREACH (Optional Providers)
# ------------------------------------------------------------------------------
# Default state is safe: Outbound email sending is disabled via global kill switch
# until manually activated in the Admin Dashboard (/admin/outreach/).
#
# Optional AI LLM Provider for dynamic personalization (Gemini 2.5/1.5 Flash):
# If omitted, system seamlessly runs on the deterministic rule-based intelligence engine.
# GEMINI_API_KEY="AIzaSy..."
#
# Optional Commercial Discovery Provider (Google Places API):
# If omitted, system utilizes the OpenStreetMap Overpass geographic discovery engine.
# GOOGLE_PLACES_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 7. PRODUCTION-READY CUSTOM CAPTCHA SERVICE (Next.js + Supabase)
# ------------------------------------------------------------------------------
# Fully independent, zero-third-party security service with HMAC cryptographic signing.
# Public Site Key identifies your site; Signing Secret remains strictly server-only.
NEXT_PUBLIC_CAPTCHA_SITE_KEY="hp_site_live_default"
CAPTCHA_SIGNING_SECRET="heyprince_captcha_super_secret_signing_key_32bytes_min_2026"


# ------------------------------------------------------------------------------
# 8. DEDICATED PYTHON AI BACKEND (FastAPI on VPS with Ollama PC Bridge)
# ------------------------------------------------------------------------------
# Set this to delegate AI tasks (news generation, autonomous agents, proposals)
# to your Python FastAPI backend on your VPS. If omitted, Next.js falls back to local routines.
AI_BACKEND_URL="http://your-vps-ip:8000"
AI_SERVICE_SECRET="replace-with-a-strong-32-byte-hex-secret"

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
# Primary object storage for media assets, blog graphics, and client documents.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="heyprince-media"
# R2_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Optional public custom domain or r2.dev URL:
# R2_PUBLIC_BASE_URL="https://assets.heyprince.in"

# ------------------------------------------------------------------------------
# 10. SOCIAL MEDIA PUBLISHING (Threads, Twitter / X, WhatsApp Channel)
# ------------------------------------------------------------------------------
# A. Threads (Meta Graph API)
# Get credentials from developers.facebook.com -> Threads Use Case
# THREADS_APP_ID="your-meta-app-id"
# THREADS_APP_SECRET="your-meta-app-secret"
# THREADS_ACCESS_TOKEN="your-threads-long-lived-user-token"
# THREADS_USER_ID="your-threads-user-id"
# THREADS_USERNAME="heyprincein"

# B. Twitter / X (API v2 with OAuth 1.0a User Context)
# Get credentials from developer.x.com
# TWITTER_API_KEY="your-consumer-api-key"
# TWITTER_API_SECRET="your-consumer-api-secret"
# TWITTER_ACCESS_TOKEN="your-oauth1-access-token"
# TWITTER_ACCESS_SECRET="your-oauth1-access-secret"
# TWITTER_BEARER_TOKEN="your-app-bearer-token"

# C. WhatsApp Channel (Official Meta Cloud API)
# Get credentials from business.facebook.com -> WhatsApp Accounts
# WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-system-token"
# WHATSAPP_CHANNEL_ID="your-whatsapp-channel-or-newsletter-id"
# WHATSAPP_BUSINESS_PHONE_ID="your-phone-number-id"
# WHATSAPP_API_VERSION="v21.0"

