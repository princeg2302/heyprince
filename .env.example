# ==============================================================================
# HeyPrince Digital Business Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for Payload CMS and Leads persistence.
# Compatible with Neon, Supabase, AWS RDS, DigitalOcean, or local PostgreSQL.
# Example: postgresql://postgres:yourpassword@127.0.0.1:5432/heyprince
# For Neon / Supabase, use your pooled connection string with sslmode=require.
DATABASE_URI="postgresql://postgres:postgres@127.0.0.1:5432/heyprince"

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS CONFIGURATION
# ------------------------------------------------------------------------------
# A strong, cryptographically secure 32+ character secret used to sign JWTs & auth tokens.
PAYLOAD_SECRET="replace-with-a-very-long-random-string-at-least-32-chars-long"

# Default password used by the seed script (npm run seed) for admin: contact@heyprince.in
PAYLOAD_ADMIN_PASSWORD="HeyPrinceAdmin2026!"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL NOTIFICATION EMAIL (Hostinger SMTP or Resend)
# ------------------------------------------------------------------------------
# Option A: Hostinger Business Email (SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="contact@heyprince.in"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM="HeyPrince Inquiries <contact@heyprince.in>"

# Destination email inbox where inquiries are received
LEAD_NOTIFICATION_EMAIL="contact@heyprince.in"

# Option B: Resend (Alternative transactional provider)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="HeyPrince <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. SERVER & CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL="https://heyprince.in"

# ------------------------------------------------------------------------------
# 5. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 6. GLOBAL LEAD INTELLIGENCE & AI OUTREACH (Optional Providers)
# ------------------------------------------------------------------------------
# Default state is safe: Outbound email sending is disabled via global kill switch
# until manually activated in the Admin Dashboard (/admin/outreach/).
#
# Optional AI LLM Provider for dynamic personalization (Gemini 2.5/1.5 Flash):
# If omitted, system seamlessly runs on the deterministic rule-based intelligence engine.
# GEMINI_API_KEY="AIzaSy..."
#
# Optional Commercial Discovery Provider (Google Places API):
# If omitted, system utilizes the OpenStreetMap Overpass geographic discovery engine.
# GOOGLE_PLACES_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE TURNSTILE CAPTCHA (Lead Protection)
# ------------------------------------------------------------------------------
# Default testing keys are enabled for local development. For production:
# Create a free Turnstile widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
