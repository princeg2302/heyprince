# HeyPrince AI Backend (FastAPI on VPS)

# Server Environment
ENVIRONMENT=production
PORT=8000
DEBUG=false

# Machine-to-Machine Shared Secret for Next.js <-> Python Auth
AI_SERVICE_SECRET=your_32_character_hmac_secret_here_2026

# Supabase PostgreSQL Database URI (pooled connection with sslmode=require)
DATABASE_URI=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Local PC Ollama Integration (over Tailscale / WireGuard private tunnel)
OLLAMA_BASE_URL=http://100.x.y.z:11434
OLLAMA_MODEL=llama3.3:70b
OLLAMA_TIMEOUT_SECONDS=25

# Cloud LLM Fallback (Google Gemini)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Image Generation
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Autonomous Scheduler
ENABLE_SCHEDULER=true
DAILY_NEWS_CRON="30 3 * * *"
CHIEF_OF_STAFF_CRON="0 4 * * *"
LEAD_SCOUT_CRON="0 5 * * *"

