<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Legacy & Alias Route Redirects
  RewriteRule ^privacy/?$ /privacy-policy/ [R=301,L]
  RewriteRule ^service/(.*)$ /services/$1/ [R=301,L]
  RewriteRule ^services/?$ /services/ai-automation/ [R=302,L]
  RewriteRule ^blog/?$ /blog/freelancing-tips-it-professionals-2026/ [R=302,L]
  RewriteRule ^freelancing-tips-it-professionals-2026/?$ /blog/freelancing-tips-it-professionals-2026/ [R=301,L]
  RewriteRule ^choose-it-services-provider/?$ /blog/choose-it-services-provider/ [R=301,L]
  RewriteRule ^professional-website-2026/?$ /blog/professional-website-2026/ [R=301,L]
  RewriteRule ^web-development-trends-2026/?$ /blog/web-development-trends-2026/ [R=301,L]
  RewriteRule ^ai-automation/?$ /services/ai-automation/ [R=301,L]
  RewriteRule ^cms-development/?$ /services/cms-development/ [R=301,L]
  RewriteRule ^react-development/?$ /services/react-development/ [R=301,L]
  RewriteRule ^php-development/?$ /services/php-development/ [R=301,L]
  RewriteRule ^python-engineering/?$ /services/python-engineering/ [R=301,L]
  RewriteRule ^seo-services/?$ /services/seo-services/ [R=301,L]
  RewriteRule ^ui-ux-design/?$ /services/ui-ux-design/ [R=301,L]

  # Serve existing physical files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve directory index if exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # SPA Fallback for all other routes to index.html
  RewriteRule ^.*$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Googlebot & Crawler Permissions
  Header set X-Robots-Tag "all"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching for production performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

